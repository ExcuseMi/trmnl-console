    /*
     * Terminal cell colors.
     *
     * The tc--fg-<n> / tc--bg-<n> classes carry xterm 256-color palette
     * indices (see the SBuffer-to-HTML spec in cli-client/src/sbuffer.rs).
     * Each index is mapped to the perceptually nearest TRMNL framework color
     * token and painted through the framework-owned --text-<token>-* /
     * --bg-<token>-* variables, so the screen-mode engine takes care of
     * reduced-palette and dithered 1-bit/2-bit rendering automatically.
     * Note that the default (unstyled) cell is black-on-white.
     *
     * The rules below are generated; regenerate with bin/gen-ansi-colors.py.
     *
     * A span may combine a fg and a bg color, so the paint follows the
     * framework's composed bg+text pattern (_text.scss): the bg fill rides
     * background-color plus a border-box image layer, while the text ink is
     * an image layer clipped to the glyphs with its light tone on a gradient
     * layer under it.
     */
    .trmnl-console span {
        color: var(--tc-fg-color, inherit);
        background-color: var(--tc-bg-color, transparent);
        background-image: var(--tc-fg-image, none), linear-gradient(var(--tc-fg-under, transparent), var(--tc-fg-under, transparent)), var(--tc-bg-image, none);
        background-repeat: repeat, repeat, repeat;
        background-size: var(--dither-bg-size, auto), auto, var(--dither-bg-size, auto);
        -webkit-background-clip: var(--tc-fg-clip, border-box), var(--tc-fg-clip, border-box), border-box;
        background-clip: var(--tc-fg-clip, border-box), var(--tc-fg-clip, border-box), border-box;
    }

    .tc--fg-0, .tc--fg-16 {
        --tc-fg-color: var(--text-black-color, var(--black));
        --tc-fg-image: var(--text-black-image, none);
        --tc-fg-clip: var(--text-black-clip, border-box);
        --tc-fg-under: var(--text-black-under, transparent);
    }

