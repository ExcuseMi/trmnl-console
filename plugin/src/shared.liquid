<div class="layout layout--left layout--top">
    <!--
        on 1x: 111 x 29 ( x ?? w/o bar )
        on 2x: ?? x ?? ( x ?? w/o bar )
    -->
    <pre class="trmnl-console {{ data.scale }}">{{ data.content_transformed | raw }}</pre>
</div>
{% if data.bar %}
    <div class="title_bar">
        {% if data.bar.icon %}
            <img class="image image-dither" src="{{ data.bar.icon }}">
        {% endif %}
        <span class="title">
            {% if data.bar.left %}
                {{ data.bar.left }}
            {% endif %}
        </span>
        {% if data.bar.right %}
            <span class="instance">{{ data.bar.right }}</span>
        {% endif %}
    </div>
{% endif %}
{% endtemplate %}

{% template error_info %}
<div class="layout w--full h--full">
    <div class="flex flex--row gap--xlarge">
        <div><img src="https://capypara.de/caution.svg" class="w--36 image image-dither"></div>
        <div class="stretch-x">
            <p>
                <span class="title">Failed to display console output</span>
            </p>
            <p>
                <span class="description description--large">
                    {{ error }}
                </span>
            </p>
        </div>
    </div>
</div>
<div class="title_bar">
    <span class="title">Console</span>
    <span class="instance">{{ trmnl.plugin_settings.instance_name }}</span>
</div>
{% endtemplate %}