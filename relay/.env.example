# Copy to .env (gitignored) and fill in.

# Shared secret trmnl-console-backend (or the CLI's --url) sends as
# `Authorization: Bearer <token>`. Generate one with e.g. `openssl rand -hex 32`.
RELAY_TOKEN=changeme

# Whether to restrict the polling GET endpoint to TRMNL's published server IPs
# (https://trmnl.com/api/ips). Leave this on unless you're doing local testing without
# network access - TRMNL sends no auth of its own on polling requests, so this is the only
# thing standing between the public internet and your captured content.
RELAY_IP_ALLOWLIST=true

# Host port to publish (see docker-compose.yml); the container always listens on 8080
# internally regardless of this.
RELAY_PORT=8901
